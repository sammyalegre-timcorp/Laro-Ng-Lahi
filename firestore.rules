rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{registrationId} {
      allow read, write: if true;
    }
    match /teams/{teamId} {
      allow read, write: if true;
    }
    match /event_config/{configId} {
      allow read, write: if true;
    }
    match /game_masters/{gameMasterId} {
      allow read, write: if true;
    }
  }
}
